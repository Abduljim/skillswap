DATABASE_URL=postgresql://user:password@host:5432/skillswap?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/skillswap?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
NODE_ENV=development
PORT=4000

# Monetization feature flags (all optional; defaults shown)
GOLD_ENABLED=true
ELITE_ENABLED=true
BOOSTS_ENABLED=true
ADS_ENABLED=false
REFERRALS_ENABLED=true

# Google Play Billing verification (server-side only; required in production)
# JSON service-account key with Play Console access, single line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
ANDROID_PACKAGE_NAME=app.skillswap.mobile

# Email (SMTP) for password recovery — any provider works:
# Gmail (App Password), Brevo, Resend SMTP, Mailgun, Zoho...
# Without these, forgot-password logs the email to the server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=SkillSwap <no-reply@skillswap.app>
