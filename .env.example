DATABASE_URL=postgresql://user:password@host:5432/skillswap?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@host:5432/skillswap?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
NODE_ENV=development
PORT=4000

# Monetization feature flags (all optional; defaults shown)
GOLD_ENABLED=true
ELITE_ENABLED=true
BOOSTS_ENABLED=true
ADS_ENABLED=false
REFERRALS_ENABLED=true

# Google Play Billing verification (server-side only; required in production)
# JSON service-account key with Play Console access, single line:
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}
ANDROID_PACKAGE_NAME=app.skillswap.mobile
